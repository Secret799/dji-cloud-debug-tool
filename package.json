{
  "name": "dji-cloud-debug-tool",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform desktop workbench for DJI Cloud API and MQTT debugging.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Secret799",
    "url": "https://github.com/Secret799"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "render:icon": "electron scripts/render-icon.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:ui": "npm run build && node scripts/electron-smoke.mjs",
    "smoke:toast": "npm run build && node scripts/toast-smoke.mjs",
    "smoke:logs": "npm run build && node scripts/remote-log-smoke.mjs",
    "smoke:mqtt": "npm run build && node scripts/mqtt-smoke.mjs",
    "smoke:webdav": "npm run build && node scripts/webdav-smoke.mjs",
    "build:zlm": "bash scripts/build-zlmediakit-macos.sh",
    "ci:build:zlm:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-zlmediakit-windows.ps1",
    "prepare:ffmpeg:mac": "bash scripts/prepare-ffmpeg-macos.sh",
    "ci:prepare:ffmpeg:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg-windows.ps1",
    "release:verify": "npm test && npm run build",
    "release:tag": "bash scripts/create-release-tag.sh",
    "package:mac": "npm run package:mac:arm64",
    "package:mac:arm64": "npm run release:verify && npm run build:zlm -- arm64 && npm run prepare:ffmpeg:mac -- arm64 && electron-builder --mac dmg zip --arm64",
    "package:mac:x64": "npm run release:verify && npm run build:zlm -- x64 && npm run prepare:ffmpeg:mac -- x64 && electron-builder --mac dmg zip --x64"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/lib-storage": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "ali-oss": "^6.23.0",
    "fast-xml-parser": "^5.11.1",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.468.0",
    "mpegts.js": "^1.8.2",
    "mqtt": "^5.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.dji-cloud-studio.desktop",
    "productName": "DJI Cloud Studio",
    "artifactName": "DJI.Cloud.Studio-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "DJI.Cloud.Studio-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "identity": "-",
      "notarize": false,
      "extraResources": [
        {
          "from": "vendor/zlmediakit/${arch}",
          "to": "zlmediakit",
          "filter": [
            "MediaServer"
          ]
        },
        {
          "from": "vendor/zlmediakit/LICENSE",
          "to": "zlmediakit/LICENSE"
        },
        {
          "from": "vendor/ffmpeg/darwin-${arch}",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "LICENSE",
            "SOURCE.txt"
          ]
        }
      ]
    },
    "dmg": {
      "title": "DJI Cloud Studio ${version}",
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "DJI.Cloud.Studio-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "extraResources": [
        {
          "from": "vendor/zlmediakit/win32-${arch}",
          "to": "zlmediakit",
          "filter": [
            "MediaServer.exe"
          ]
        },
        {
          "from": "vendor/zlmediakit/LICENSE",
          "to": "zlmediakit/LICENSE"
        },
        {
          "from": "vendor/ffmpeg/win32-${arch}",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "LICENSE",
            "SOURCE.txt"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "DJI.Cloud.Studio-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "DJI.Cloud.Studio-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
